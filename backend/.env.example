TCMB_API_KEY=

# Optional override for TCMB Survey of Market Participants:
# 12-month-ahead annual CPI expectation, arithmetic mean.
PRIVATE_SECTOR_INFLATION_EXPECTATION_SERIES=TP.BEK.S01.E.A

# Optional alternative: provide a JSON endpoint and the app will use the latest numeric value.
PRIVATE_SECTOR_INFLATION_EXPECTATION_URL=

# World Bank sources are optional and only needed for the World Bank source.
WORLD_BANK_TURKEY_INFLATION_URL=
WORLD_BANK_TURKEY_CPI_INDEX_URL=
WORLD_BANK_TURKEY_WPI_URL=
